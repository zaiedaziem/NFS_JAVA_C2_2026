### Day 13: Forms and Validation backend support
### Run Spring Boot first: mvn spring-boot:run

### Login as seeded admin
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin@12345"
}


### Copy token from login response
@token = eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhZG1pbkBleGFtcGxlLmNvbSIsInJvbGUiOiJBRE1JTiIsImlzcyI6InN1cHBvcnQtZGVzay1hcGkiLCJuYW1lIjoiQWRtaW4gVXNlciIsImV4cCI6MTc4NjcyMjE1OSwiaWF0IjoxNzg2NzE4NTU5LCJ1c2VySWQiOiI2YTc0NDEyMzk5NGI2Y2RmMmZhOTExNTYifQ.PRDe2_J6cwDooWfPkm68fbIbY-0A1zPlEDhNv_IVZOc


### Create ticket from frontend form
POST http://localhost:8080/api/v1/tickets
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Cannot connect to VPN",
  "description": "VPN client fails to connect from home network",
  "category": "Network",
  "priority": "HIGH",
  "createdBy": "trainer@example.com"
}


### Get all tickets and copy one id for update
GET http://localhost:8080/api/v1/tickets
Authorization: Bearer {{token}}


### Update ticket from frontend form
PUT http://localhost:8080/api/v1/tickets/6a7f299dd81b565fecbd61c6
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Cannot connect to VPN",
  "description": "VPN client fails to connect from home network - escalated to network team",
  "category": "Network",
  "priority": "HIGH",
  "status": "IN_PROGRESS"
}


### Invalid update priority - should return 400
PUT http://localhost:8080/api/v1/tickets/6a7f299dd81b565fecbd61c6
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Cannot connect to VPN",
  "description": "VPN client fails to connect from home network",
  "category": "Network",
  "priority": "URGENT",
  "status": "IN_PROGRESS"
}


### Invalid update status - should return 400
PUT http://localhost:8080/api/v1/tickets/6a7f299dd81b565fecbd61c6
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "title": "Cannot connect to VPN",
  "description": "VPN client fails to connect from home network",
  "category": "Network",
  "priority": "HIGH",
  "status": "RESOLVED"
}
