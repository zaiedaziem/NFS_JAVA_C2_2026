# Support Desk API Configuration
# Copy this file to .env and fill in real values. Never commit .env.

# ===== REQUIRED for production =====
# JWT secret for token signing (must be at least 32 characters).
# The demo default in application.properties is fine for local classroom use only.
JWT_SECRET=your-secure-jwt-secret-minimum-32-characters-here-replace-me

# ===== OPTIONAL (defaults provided in application.properties) =====
# JWT token expiration in minutes
JWT_EXPIRATION_MINUTES=60

# MongoDB connection string. When running the backend in Docker and MongoDB
# on your host machine, use host.docker.internal instead of localhost.
SPRING_DATA_MONGODB_URI=mongodb://host.docker.internal:27017/support_desk_db
